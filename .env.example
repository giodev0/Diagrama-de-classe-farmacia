# Copie este arquivo para .env na raiz do repositorio antes de rodar
# docker compose up. O usuario-service nao sobe sem estas variaveis.
#
#   cp .env.example .env
#
# O .env e ignorado pelo git: cada pessoa tem o seu, com valores proprios.

# Chave usada para assinar os tokens JWT do usuario-service.
JWT_SECRET=troque-esta-chave-em-cada-maquina

# Administrador criado automaticamente na primeira execucao.
ADMIN_EMAIL=admin@farmacia.com
ADMIN_SENHA=troque-esta-senha
