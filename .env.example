# Modelo de configuracao local. Copie para .env antes de subir o sistema:
#
#   cp .env.example .env
#
# O .env e ignorado pelo git de proposito: cada pessoa tem o seu, com os
# valores da propria maquina. O que se compartilha com a equipe e ESTE
# arquivo de exemplo, que e versionado.
#
# O arquivo e lido pelo docker compose, que substitui os ${...} do
# docker-compose.yml e injeta os valores dentro dos containers.


# ---------------------------------------------------------------------------
# usuario-service (Python) -- OBRIGATORIAS
# Nao tem valor padrao: sem elas o servico nao sobe.
# ---------------------------------------------------------------------------

# Chave usada para assinar os tokens JWT. Troque em cada maquina.
JWT_SECRET=troque-esta-chave-em-cada-maquina

# Administrador criado automaticamente na primeira execucao.
ADMIN_EMAIL=admin@farmacia.com
ADMIN_SENHA=troque-esta-senha


# ---------------------------------------------------------------------------
# produto-service e estoque-service (Java) -- OPCIONAIS
# Todas tem valor padrao no docker-compose.yml, entao o sistema sobe mesmo
# sem definir nada aqui. Descomente so o que precisar mudar.
# ---------------------------------------------------------------------------

# Senha do root dos dois bancos MySQL.
#MYSQL_ROOT_PASSWORD=root

# Usuario que as aplicacoes usam para falar com o banco.
#MYSQL_APP_USER=farmacia
#MYSQL_APP_PASSWORD=farmacia

# Portas que os bancos publicam no SEU computador. Mude se der conflito,
# por exemplo se voce ja tem um MySQL ocupando a 3306 ou a 3307.
# Isso nao afeta a comunicacao entre os containers, que e sempre na 3306.
#PRODUTO_DB_PORT=3307
#ESTOQUE_DB_PORT=3308
